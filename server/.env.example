# ----------------------------------------------------------------------------
# Danske Bank PSD2 (Berlin Group NextGenPSD2) sandbox configuration
# Copy to ".env" and fill in the values from your app on
# https://developers.danskebank.com  (Regulatory APIs -> PSD2).
# ----------------------------------------------------------------------------

# Server
PORT=8787
# Allowed browser origin for the dashboard (CORS). Use the URL you serve dashboard.html from.
DASHBOARD_ORIGIN=http://localhost:5500

# --- Danske Bank API gateway ------------------------------------------------
# Base URL of the PSD2 AIS API (confirm the exact sandbox host on the portal).
# The path prefix below follows the Berlin Group XS2A standard Danske implements.
DANSKE_API_BASE=https://sandbox.danskebank.com/sandbox-open-banking/private/psd2/ais/v1

# OAuth2 endpoints (Berlin Group OAuth2 "pre-step" / SCA approach)
DANSKE_AUTH_URL=https://sandbox.danskebank.com/sandbox-open-banking/oauth2/authorize
DANSKE_TOKEN_URL=https://sandbox.danskebank.com/sandbox-open-banking/oauth2/token

# --- App credentials (from the developer portal) ----------------------------
DANSKE_CLIENT_ID=replace-me
DANSKE_CLIENT_SECRET=replace-me
# Must exactly match the redirect URI registered for the app.
DANSKE_REDIRECT_URI=http://localhost:8787/api/danske/callback

# IBM API Connect gateway subscription keys (Danske fronts PSD2 with IBM APIc).
# Leave blank if your sandbox app does not require them.
DANSKE_IBM_CLIENT_ID=
DANSKE_IBM_CLIENT_SECRET=

# --- eIDAS QWAC client certificate for mTLS (required in real PSD2) ----------
# Paths to PEM files. Leave blank in a mock/sandbox tier that doesn't enforce mTLS.
DANSKE_TLS_CERT_PATH=
DANSKE_TLS_KEY_PATH=

# PSU IP forwarded on AIS calls (Berlin Group requires it for PSU-initiated reads)
PSU_IP_ADDRESS=127.0.0.1
